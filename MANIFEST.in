include LICENSE
include README.md
recursive-include pyxtabond2/datasets *

# setuptools' sdist defaults sweep in tests/test*.py even without a rule
# asking for it; prune them since tests/fixtures/*.json (which they need
# to run) is not shipped, so a sdist-only checkout can't run them anyway.
prune tests

global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude *.nbc
global-exclude *.nbi
